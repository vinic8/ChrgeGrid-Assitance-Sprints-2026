# Copie este arquivo para ".env" e preencha com seus valores reais.
# NUNCA commite o ".env" (já está no .gitignore).

# --- Provider A: Ollama Cloud (modelo principal do chatbot) ---
# Chave da Ollama Cloud — gere em https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Host da Ollama Cloud. Não precisa mudar a menos que você use um gateway/proxy próprio.
OLLAMA_HOST=https://ollama.com

# Modelo principal, servido pela Ollama Cloud (Provider A)
MODEL_PRIMARY=gpt-oss:120b-cloud

# --- Provider B: Groq (comparativo multi-provider do Bloco B) ---
# Chave da Groq — gere em https://console.groq.com/keys
GROQ_API_KEY=

# Modelo open-weight servido pela Groq (Provider B)
# Nota: llama-3.3-70b-versatile (usado nas Sprints 1/2) foi descontinuado na Groq;
# qwen/qwen3.8-27b é a alternativa open-weight que respondeu de forma limpa nos testes
# (qwen3.6-27b vaza raciocínio interno "<think>" na resposta; gpt-oss-20b via Groq
# retornou conteúdo vazio pelo mesmo motivo de "reasoning" consumir a saída).
MODEL_GROQ=qwen/qwen3.8-27b

# Parâmetros padrão de geração (usados nos dois providers)
TEMPERATURE=0.2
MAX_TOKENS=600

# Limite de tokens da memória de conversa por sessão (Aula 02)
MEMORIA_LIMITE_TOKENS=1500

# Versão ativa do system prompt (ver prompts/VERSOES.md)
SYSTEM_PROMPT_VERSION=v6
