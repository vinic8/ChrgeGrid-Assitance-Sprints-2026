# Copie este arquivo para ".env" e preencha com seus valores reais.
# NUNCA commite o ".env" (já está no .gitignore).

# --- Provider A: Ollama Cloud — Gemma 4 ---
# Chave da Ollama Cloud — gere em https://ollama.com/settings/keys
OLLAMA_API_KEY=

# Host da Ollama Cloud. Não precisa mudar a menos que você use um gateway/proxy próprio.
OLLAMA_HOST=https://ollama.com

# Modelo do Provider A
MODEL_PRIMARY=gemma4:cloud

# --- Provider B: Groq — Qwen 3.8 ---
# Chave da Groq — gere em https://console.groq.com/keys
GROQ_API_KEY=

# Modelo do Provider B
MODEL_GROQ=qwen/qwen3.8-27b

# --- Parâmetros de geração (iguais nos dois providers; ver docs/relatorio_modelos.md) ---
TEMPERATURE=0
TOP_P=0.9
MAX_TOKENS=800

# Limite de tokens da memória de conversa por sessão
MEMORIA_LIMITE_TOKENS=1500

# Versão ativa do system prompt (persona) — ver prompts/VERSOES.md
SYSTEM_PROMPT_VERSION=v7

# --- RAG (Sprint 04; ver docs/relatorio_rag.md) ---
# Versão ativa do prompt RAG (src/rag/prompt_rag.py): v1, v2, v3 ou v4
RAG_PROMPT_VERSION=v4
# Top-k de trechos recuperados
RAG_K=6
# Estratégia de chunking: por_secao_tabelas (padrão), por_secao (iteração 2) ou recursivo_basico (iteração 1)
RAG_CHUNKING=por_secao_tabelas
# Busca: hibrida_expandida (padrão: vetorial + BM25 com expansão de consulta), hibrida ou vetorial
RAG_BUSCA=hibrida_expandida
# Porta sobre o melhor score de cosseno (0 = desligada). Foi 0,69 nas iterações 3 a 5;
# desligada na iteração 6 porque recusava perguntas legítimas curtas (docs/relatorio_rag.md §5)
RAG_LIMIAR_RELEVANCIA=0

# Embeddings nomic-embed-text: fastembed (local, padrão) ou ollama
# (a Ollama Cloud retorna 401 no endpoint de embeddings — ver src/rag/embeddings.py)
EMBEDDINGS_BACKEND=fastembed
EMBEDDINGS_MODEL=nomic-embed-text
# Usado só com EMBEDDINGS_BACKEND=ollama (ex.: Ollama local com "ollama pull nomic-embed-text")
OLLAMA_EMBEDDINGS_HOST=http://localhost:11434
